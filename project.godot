; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dot-sql"
config/description="SQLite, PostgreSQL and MySQL for the Dot family: drivers, one dialect layer, tables as plain data, and versioned migrations."
config/version="0.1.0"
run/main_scene="res://examples/sql_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_sql/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
